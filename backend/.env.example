# 应用配置
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 数据库配置 - MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=superbizagent

# 数据库配置 - Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_base

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RabbitMQ配置
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# 存储配置
VIDEO_STORAGE_PATH=./storage/videos
MAINTENANCE_STORAGE_PATH=./storage/maintenance
KNOWLEDGE_BASE_PATH=./storage/knowledge_base

# LLM配置
DEFAULT_LLM_API_KEY=your_api_key_here
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-3.5-turbo

# Whisper配置
WHISPER_MODEL_SIZE=tiny

# OCR配置
OCR_API_KEY=your_ocr_api_key
